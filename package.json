{
  "name": "scow",
  "version": "1.11.8",
  "private": true,
  "scripts": {
    "build": "turbo run build",
    "build:adapters": "turbo run build --filter \"@scow/scow-adapters\"",
    "build:scowd": "turbo run build --filter \"@scow/scowd\"",
    "build:cli": "turbo run build --filter \"@scow/cli\"",
    "build:scow": "turbo run build --filter=\"!@scow/docs\" --filter=\"!@scow/cli\" --filter=\"!@scow/scow-adapters\" --filter=\"!./dev/**\"",
    "build:libs": "turbo run build --filter \"./libs/**\"",
    "build:images": "docker build -f docker/Dockerfile.scow -t scow .",
    "build:protos": "turbo run build --filter \"./libs/protos/**\"",
    "prepareDev": "turbo run prepareDev",
    "prune": "pnpm clean --yes && pnpm bootstrap --ci -- --production",
    "dev:libs": "turbo run dev --concurrency 100% --filter \"./libs/**\"",
    "devenv": "docker compose --env-file dev/.env.dev -f dev/docker-compose.dev.yml up -d",
    "devenv:stop": "docker compose --env-file dev/.env.dev -f dev/docker-compose.dev.yml down",
    "test": "turbo run test",
    "test:ci": "pnpm run -r test --ci --coverage --runInBand",
    "prepare": "node -e \"try { import('husky').then((d) => console.log(d.default())) } catch (e) {if (e.code !== 'MODULE_NOT_FOUND' && !e.message.startsWith('.git')) throw e}\"",
    "lint": "oxlint . && turbo run lint",
    "ci:version": "node scripts/version.mjs",
    "ci:publish": "pnpm publish -r",
    "api:breaking": "cd protos && pnpm exec buf breaking --against '../.git#subdir=protos'"
  },
  "devDependencies": {
    "@bufbuild/buf": "1.59.0",
    "@changesets/cli": "2.27.11",
    "@commitlint/config-conventional": "19.6.0",
    "@pnpm/lockfile-file": "9.1.3",
    "@pnpm/logger": "5.0.0",
    "@types/jest": "29.5.14",
    "@types/node": "24.5.2",
    "concurrently": "9.1.2",
    "cross-env": "7.0.3",
    "cz-conventional-changelog": "3.3.0",
    "dotenv": "16.4.7",
    "dotenv-cli": "8.0.0",
    "front-matter": "4.0.2",
    "globby": "14.0.2",
    "husky": "9.1.7",
    "jest": "29.7.0",
    "jest-extended": "4.0.2",
    "node-glob": "1.2.0",
    "nodemon": "3.1.9",
    "oxfmt": "0.38.0",
    "oxlint": "1.53.0",
    "oxlint-tsgolint": "0.16.0",
    "pino-pretty": "13.0.0",
    "pm2": "5.4.3",
    "rimraf": "6.0.1",
    "ts-jest": "29.2.5",
    "ts-node": "10.9.2",
    "tsc-alias": "1.8.10",
    "tsconfig-paths": "4.2.0",
    "tsx": "4.22.4",
    "turbo": "2.8.16",
    "typescript": "5.9.3"
  },
  "engines": {
    "node": "22.21.1"
  },
  "volta": {
    "node": "22.21.1"
  },
  "packageManager": "pnpm@10.25.0",
  "pnpm": {
    "patchedDependencies": {
      "next@16.3.4": "patches/next@16.3.4.patch"
    },
    "neverBuiltDependencies": []
  }
}
