FROM ccrepo.pku.edu.cn/dockerhub/library/node:22-alpine AS base

RUN sed -i 's/dl-cdn.alpinelinux.org/mirrors.ustc.edu.cn/g' /etc/apk/repositories

RUN apk update

FROM base AS builder

RUN apk add libc6-compat python3 make gcc g++ curl git

RUN npm i -g corepack@0.31.0

RUN corepack enable

WORKDIR /app

COPY package.json .
COPY pnpm-lock.yaml .
COPY patches ./patches

ENV COREPACK_NPM_REGISTRY https://registry.npmmirror.com

RUN pnpm config set registry https://registry.npmmirror.com

RUN pnpm fetch

COPY . .

RUN pnpm i --offline --frozen-lockfile

RUN node scripts/createVersionFile.mjs version.json

RUN pnpm build:scow

RUN node scripts/copyDist.mjs

WORKDIR /app/dist

COPY patches ./patches

RUN pnpm i --offline --prod --frozen-lockfile

# delete next.js build caches to reduce 200MB+ image size
RUN rm -rf apps/mis-web/.next/cache apps/portal-web/.next/cache apps/ai/.next/cache apps/notification/.next/cache apps/resource/.next/cache apps/quantum/.next/cache

FROM base AS runner

RUN apk add nginx

WORKDIR /app

COPY --from=builder /app/dist .
COPY --from=builder /app/version.json ./

COPY docker/entrypoint.sh .
RUN chmod +x entrypoint.sh

ENV NODE_ENV=production

EXPOSE 3000 80 5000

ENTRYPOINT [ "./entrypoint.sh" ]

