{
  "js/ts.tsdk.path": "node_modules/typescript/lib",
  "protobuf.buf.path": "${workspaceFolder}/node_modules/.bin/buf",
  "protobuf.externalLinter.bufPath": "${workspaceFolder}/node_modules/.bin/buf",
  "protobuf.formatter.preset": "buf",
  "editor.defaultFormatter": "oxc.oxc-vscode",
  "editor.formatOnSave": true,
  "[json]": {
    "editor.defaultFormatter": "oxc.oxc-vscode",
  },
  "[typescript]": {
    "editor.defaultFormatter": "oxc.oxc-vscode",
  },
  "[go]": {
    "editor.defaultFormatter": "golang.go",
  },
  "[typescriptreact]": {
    "editor.defaultFormatter": "oxc.oxc-vscode",
  },
}
