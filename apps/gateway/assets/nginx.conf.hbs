map $http_accept $proxy_accept_encoding {
      default $http_accept;
      "~*text/stream" "";
}

map $http_upgrade $proxy_connection {
      default upgrade;
      "" "";
}

server {

  server_name {{ ALLOWED_SERVER_NAME }};

  resolver {{ RESOLVER }} valid=10s;
  resolver_timeout 5s;

  sendfile on;

  listen 80;

  client_max_body_size {{ CLIENT_MAX_BODY_SIZE }};
  access_log /dev/stdout;
  error_log stderr;

  proxy_read_timeout {{ PROXY_READ_TIMEOUT }};

  location {{ BASE_PATH }}/meta {
    set $meta_server {{ META_SERVER_URL }};
    proxy_pass $meta_server;

    include includes/headers;
  }

  {{#if PORTAL_ENABLED}}
  location {{ BASE_PATH }}{{ PORTAL_PATH }} {
    set $portal_path_url {{ PORTAL_PATH_INTERNAL_URL }};
    proxy_pass $portal_path_url;

    proxy_set_header Accept-Encoding $proxy_accept_encoding;
    include includes/headers;
    include includes/websocket;
  }
  {{/if}}

  location {{ BASE_PATH }}{{ MIS_PATH }} {
    set $mis_path_url {{ MIS_PATH_INTERNAL_URL }};
    proxy_pass $mis_path_url;

    include includes/headers;
    include includes/websocket;
  }

  {{#if AI_ENABLED}}
  location {{ BASE_PATH }}{{ AI_PATH }} {
    set $ai_path_url {{ AI_PATH_INTERNAL_URL }};
    proxy_pass $ai_path_url;

    proxy_set_header Accept-Encoding $proxy_accept_encoding;

    include includes/headers;
    include includes/websocket;
  }

  location {{ BASE_PATH }}{{ AI_PATH }}/api/jobs/podLogs {
    # 与 /ai 一致的上游
    set $ai_path_url {{ AI_PATH_INTERNAL_URL }};
    proxy_pass $ai_path_url;

     # —— 关键：SSE 相关 ——
    proxy_buffering off;  # 禁用缓冲
    gzip off;  # 禁用压缩
    chunked_transfer_encoding on;  # 开启分块传输
    proxy_set_header Connection "";  # 保持连接

    # 与 /ai 一致的上游
    proxy_set_header Accept-Encoding $proxy_accept_encoding;
    include includes/headers;
    include includes/websocket;
  }
  {{/if}}

  {{#if QUANTUM_ENABLED}}
  location {{ BASE_PATH }}{{ QUANTUM_PATH }} {
    set $quantum_path_url {{ QUANTUM_PATH_INTERNAL_URL }};
    proxy_pass $quantum_path_url;

    proxy_set_header Accept-Encoding $proxy_accept_encoding;

    include includes/headers;
    include includes/websocket;
  }
  {{/if}}

  location {{ BASE_PATH }}{{ NOTIFICATION_PATH }} {
    set $notification_path_url {{ NOTIFICATION_PATH_INTERNAL_URL }};
    proxy_pass $notification_path_url;

    include includes/headers;
    include includes/websocket;
  }

  {{#if VNC_ENABLED}}
  location {{ BASE_PATH }}{{ VNC_PATH }} {
    proxy_pass {{ NOVNC_INTERNAL_URL }};

    include includes/headers;
    include includes/websocket;
  }
  {{/if}}

  location {{ BASE_PATH }}{{ PUBLIC_PATH }} {
    alias {{ PUBLIC_DIR }};
    autoindex off;
  }

  location ~ ^{{ BASE_PATH }}/auth/public/(.*) {
    set $auth {{ AUTH_URL }};
    proxy_pass $auth/public/$1?$args;

    include includes/headers;
  }

  location {{ BASE_PATH }}{{ RESOURCE_PATH }} {
    set $resource_path_url {{ RESOURCE_PATH_INTERNAL_URL }};
    proxy_pass $resource_path_url;

    include includes/headers;
    include includes/websocket;
  }

  error_page   500 502 503 504  /50x.html;

  location = /__basic_status__ {
    stub_status;
  }


  location = /50x.html {
    root   /usr/share/nginx/html;
  }

  {{ EXTRA }}
}

{{ DEFAULT_SERVER_BLOCK }}
