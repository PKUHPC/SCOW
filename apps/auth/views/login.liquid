<!DOCTYPE html>
<html>

<head>
  <title>{{ authTexts.login.login }} {{ titleTag }}</title>
  <link href="{{ cssUrl }}" rel="stylesheet">
  <link rel="icon" type="image/x-icon" href="{{ faviconUrl }}"></link>
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <style>
    body {
      height: 100%;
      background-image:
        url("{{ backgroundImagePath }}"),
        url("{{ backgroundDefaultImagePath }}");
      background-repeat: no-repeat;
      background-color: #fff;
      background-size: cover;
      min-height: 100vh;
      margin: 0;
      display: flex;
      flex-direction: column;
      overflow-x: auto;
    }
    .button-primary {
        background-color: {{ themeColor }};
    }
    svg {
      height: 100%;
      width: 100%;
    }
    .eye-toggle {
      cursor: pointer;
      background-color: #8C8C8C;
      transition: background-color 0.2s ease;
      -webkit-mask-repeat: no-repeat;
      mask-repeat: no-repeat;
      -webkit-mask-position: center;
      mask-position: center;
      -webkit-mask-size: contain;
      mask-size: contain;
    }
    .eye-toggle:hover {
      background-color: {{ themeColor }};
    }
    .login-main {
      display: flex;
      width: 100%;
      flex: 0 0 auto;
      --logo-bottom-offset: 7rem;
      --footer-outer-height: 0px;
      --panel-gap: 22.5rem;
      --login-left-half-height: 0rem;
      margin-top: var(--logo-bottom-offset);
      min-height: max(0px, calc(100vh - var(--logo-bottom-offset) - var(--footer-outer-height)));
    }
    .login-col {
      width: 50%;
    }
    .login-left {
      display: flex;
      align-items: center;
      justify-content: flex-end;
      padding-right: calc(var(--panel-gap) / 2);
    }
    .login-right {
      display: flex;
      align-items: flex-start;
      justify-content: center;
      flex-direction: column;
      padding-left: calc(var(--panel-gap) / 2);
    }
    .login-right-content {
      width: max-content;
      max-width: 100%;
    }
    .slogan-title {
      line-height: 3rem;
    }
    .login-footer {
      flex: 0 0 auto;
      position: fixed;
      left: 0;
      right: 0;
      bottom: 0;
    }
    @media screen and (max-width: 1920px) {
      .login-main {
        --panel-gap: 22.5rem;
      }
    }
    @media screen and (max-width: 1600px) {
      .login-main {
        --panel-gap: 15rem;
      }
    }
    @media screen and (max-width: 1200px) {
      .login-main {
        --panel-gap: 7.5rem;
      }
    }
    @media screen and (max-width: 992px) {
      .login-main {
        --panel-gap: 4.5rem;
      }
    }
    @media screen and (max-width: 720px) {
      .login-main {
        position: relative;
        min-height: 0;
        height: auto;
        flex-direction: column;
        justify-content: flex-start;
        align-items: center;
        padding-top: max(1.5rem, calc((100vh - var(--logo-bottom-offset)) / 2 - var(--login-left-half-height)));
        padding-bottom: 1.5rem;
      }
      .login-col {
        width: 100%;
        height: auto;
      }
      .login-left {
        position: relative;
        left: auto;
        top: auto;
        transform: none;
        justify-content: center;
        padding-right: 0;
      }
      .login-right {
        position: relative;
        left: auto;
        top: auto;
        transform: none;
        width: 100%;
        padding-left: 0;
        justify-content: flex-start;
        align-items: center;
        margin-top: 4rem;
      }
      .login-right-content {
        text-align: center;
      }
      .login-footer {
        position: static;
      }
    }
  </style>
</head>

<body style="font-family:Roboto">
    <div class="fixed top-9 left-12 login-logo">
      {% if logoLink == "" %}
      <img class="w-40" src="{{ logoUrl }}" alt="logo">
      {% else %}
      <a href="{{ logoLink }}" target="_blank">
        <img class="w-40" src="{{ logoUrl }}" alt="logo">
      </a>
      {% endif %}
    </div>
    <div class="login-main">
      <div class="login-col login-left">
        <div class="w-72 max-w-md min-w-max bg-white rounded-xl pt-12 pb-4">
          <form id="loginForm" method="post" action="">
            <div class="mb-14 text-2xl font-semibold text-center">{{ authTexts.login.accountPasswordLogin }}</div>
            <div class="px-10 flex flex-col items-center">
              <div class="w-72 mb-6">
                <input type='text' name="username" placeholder="{{ authTexts.login.userId }}" required
                    class="px-4 w-full border rounded-lg py-2 text-gray-700 focus:outline-none" />
              </div>
              <div class="w-72 mb-6">
                <div class="password-field relative flex items-center">
                    <input id="password" name="password" placeholder="{{ authTexts.login.password }}" type="password" required
                        class="px-4 w-full border rounded-lg py-2 text-gray-700 focus:outline-none" />
                    <div id="eye-elem" class="eye-toggle absolute w-5 h-5 right-3 bg-contain"></div>
                </div>
              </div>
              {% if enableTotp %}
                <div class="w-72 mb-6">
                  <div class="flex items-center">
                    <input name="otpCode" placeholder="{{ authTexts.login.otpVCode }}" type="text" required
                      class="px-4 w-full py-2 border rounded text-gray-700 focus:outline-none"/>
                  </div>
                </div>
              {% endif %}
              {% if enableCaptcha %}
                <div class="w-72 mb-6">
                  <div class="flex items-center">
                    <input name="code" placeholder="{{ authTexts.login.inputVCode }}" type="text" required
                        class=" px-4 w-full border rounded py-2 text-gray-700 focus:outline-none" />
                    <div id="captcha" onclick="refreshCaptcha()" class="cursor-pointer">{{ code }}</div>
                    <script>
                      function refreshCaptcha(){
                        const captchaDiv = document.getElementById("captcha");
                        fetch("{{ refreshCaptchaPath }}", {
                          method: "POST",
                          headers: { "Content-Type": "application/json" },
                          body: JSON.stringify({
                            token: "{{ token }}",
                          }),}
                          ).then( async function (response) {
                            captchaDiv.innerHTML = await response.text();
                          }).catch(() => {
                            captchaDiv.textContent = "{{ authTexts.login.refreshError }}"
                          });
                      }
                    </script>
                  </div>
                </div>

              {% else %}
                <input type="hidden" name="code" value="" />
              {% endif %}

              <input type="hidden" name="token" value="{{ token }}" />
              <input type="hidden" name="callbackUrl" value="{{ callbackUrl | escape }}" />

              <div class="min-h-4 w-72 flex items-center justify-center text-center text-red-600 text-sm">
                {% if verifyCaptchaFail %}
                  {{ authTexts.login.invalidVCode }}
                {% elsif errParamrs.err %}
                  {% if authTexts.login[errParamrs.errMessage] %}
                    {% if errParamrs.lockedMinutes %}
                      {{ authTexts.login[errParamrs.errMessage] }} {{ errParamrs.lockedMinutes }} {{ authTexts.login[errParamrs.dynamicsErrMessage] }}
                    {% elsif remainCount %}
                      {{ authTexts.login[errParamrs.errMessage] }}{{ remainCount }}{{ authTexts.login.invalidPasswordRemainSuffix }}
                    {% else %}
                      {{ authTexts.login[errParamrs.errMessage] }}
                    {% endif %}
                  {% else %}
                    {{ authTexts.login.invalidInput }}
                  {% endif %}
                {% elsif verifyOtpFail %}
                  {{ authTexts.login.invalidOtp }}
                {% endif %}
              </div>
              <button type="submit" class="w-72 py-2 mb-14 mt-4 rounded-lg button-primary text-gray-100 focus:outline-none">
                  {{ authTexts.login.login }}
              </button>
            </div>
          </form>
          {% if showBindOtpButton %}
            <div class="px-12 mt-4">
              <form action="{{ otpBasePath }}/bind" method="get">
                <button type="submit" name="action" value="bindOtp" class="px text-gray-400">
                  {{ authTexts.login.bindOtp }}
                </button>
                <input type="hidden" name="callbackUrl" value="{{ callbackUrl | escape }}" />
              </form>
            </div>
          {% endif %}
        </div>
      </div>
      <div class="login-col login-right hidden-xs">
        <div class="login-right-content">
          <div class="slogan-title text-4xl font-semibold mb-16"  style="color: {{ sloganColor }};">{{ sloganTitle | default: authTexts.login.platformSystem}}</div>
          {% for sloganText in sloganTextArr %}
            <div class="text-2xl {% if forloop.last %}mb-0{% else %}mb-6{% endif %}"  style="color: {{ sloganColor }}">{{ sloganText }}</div>
          {% endfor %}
        </div>
      </div>
    </div>

    {%- if footerText != "" -%}
      <div class="login-footer w-full pt-6 mb-4 text-center text-white text-xs" style="color: {{ footerTextColor }}">
        {{ footerText | default: 'Powered by <a href="https://github.com/PKUHPC/private-scow" target="_blank">SCOW</a>' }}
      </div>
    {%- endif -%}

    {% if changePasswordPamars.changePasswordFlag %}
      <div id="change-password-modal" class="fixed inset-0 bg-black bg-opacity-50 z-50">
        <div class="flex items-center justify-center min-h-screen">
          <div class="bg-white rounded-lg px-7 py-8 max-w-xl w-full mx-4">
            <h3 class="text-2xl font-semibold mb-4">{{ authTexts.changePassword.title }}</h3>
            <div class="text-red-700">{{authTexts.changePassword.forcePasswordChange}}</div>
            <form>
              <div class="space-y-4">
                <div>
                  <label class="block font-medium text-gray-700 mt-6 mb-2 ml-2">
                    <span>{{ authTexts.changePassword.userid }}</span>
                  </label>
                  <input value="{{changePasswordPamars.username}}" disabled class="px-8 w-full border rounded px-3 py-2 text-gray-700 " required>
                </div>

                <div>
                  <label class="block font-medium text-gray-700">
                    <span class="text-red-500">*</span>
                    <span>{{ authTexts.changePassword.newPassword }}</span>
                  </label>
                <div>
                <div class="password-field relative flex items-center mb-4 mt-2">
                  <input type="password" name="newPassword" placeholder="{{ authTexts.changePassword.passwordRuleVerification }}"
                      class="px-8 w-full border rounded px-3 py-2 text-gray-700 focus:outline-none" autocomplete="new-password">
                  <div class="eye-toggle absolute w-5 h-5 right-3 bg-contain"></div>
                </div>

                <div>
                  <label class="block font-medium text-gray-700">
                    <span class="text-red-500">*</span>
                    <span>{{ authTexts.changePassword.confirmPassword }}</span>
                  </label>
                <div>
                <div class="password-field relative flex items-center mb-4 mt-2">
                  <input type="password" name="confirmPassword" placeholder="{{ authTexts.changePassword.passwordRuleVerification }}"
                      class="px-8 w-full border rounded px-3 py-2 text-gray-700 focus:outline-none">
                  <div class="eye-toggle absolute w-5 h-5 right-3 bg-contain"></div>
                </div>

                <p id="modal-bottom-text" class="hidden my-4 text-center text-red-600"></p>
              </div>

              <div class="mt-6 flex justify-end space-x-3">
                <button id="submit-btn" type="button" onclick="handleChangePassword()"
                  class="px-4 py-1 text-white rounded button-primary text-gray-100 focus:outline-none">
                  {{ authTexts.changePassword.confirm }}
                </button>
                <button type="button"
                  onclick="hideChangePasswordModal()"
                  class="px-4 py-1 border rounded hover:bg-gray-50">
                  {{ authTexts.changePassword.cancel }}
                </button>
                <script>
                  function refreshCaptcha(){
                    const captchaDiv = document.getElementById("captcha");
                    fetch("{{ refreshCaptchaPath }}", {
                      method: "POST",
                      headers: { "Content-Type": "application/json" },
                      body: JSON.stringify({
                        token: "{{ token }}",
                      }),}
                      ).then( async function (response) {
                        captchaDiv.innerHTML = await response.text();
                      }).catch(() => {
                        captchaDiv.textContent = "{{ authTexts.login.refreshError }}"
                      });
                  }
                </script>
              </div>
            </form>
          </div>
        </div>
      </div>
    {% endif %}

    <script>
      const loginMainElem = document.querySelector('.login-main');
      const loginLeftElem = document.querySelector('.login-left');
      const loginLogoElem = document.querySelector('.login-logo');
      const loginFooterElem = document.querySelector('.login-footer');

      function updateLoginLayout() {
        if (!loginMainElem || !loginLeftElem) {
          return;
        }

        if (loginLogoElem) {
          const logoBottom = loginLogoElem.getBoundingClientRect().bottom;
          const viewportHeight = window.innerHeight || document.documentElement.clientHeight;
          const clampedLogoBottom = Math.min(Math.max(logoBottom, 0), viewportHeight);
          loginMainElem.style.setProperty('--logo-bottom-offset', clampedLogoBottom + 'px');
        }

        if (loginFooterElem) {
          const footerRect = loginFooterElem.getBoundingClientRect();
          const footerStyles = getComputedStyle(loginFooterElem);
          const footerMarginTop = parseFloat(footerStyles.marginTop) || 0;
          const footerMarginBottom = parseFloat(footerStyles.marginBottom) || 0;
          const footerOuterHeight = footerRect.height + footerMarginTop + footerMarginBottom;
          loginMainElem.style.setProperty('--footer-outer-height', footerOuterHeight + 'px');
        } else {
          loginMainElem.style.setProperty('--footer-outer-height', '0px');
        }

        if (window.matchMedia('(max-width: 720px)').matches) {
          const halfHeight = loginLeftElem.getBoundingClientRect().height / 2;
          const rootFontSize = parseFloat(getComputedStyle(document.documentElement).fontSize) || 16;
          loginMainElem.style.setProperty('--login-left-half-height', (halfHeight / rootFontSize) + 'rem');
        } else {
          loginMainElem.style.setProperty('--login-left-half-height', '0rem');
        }
      }

      window.addEventListener('resize', updateLoginLayout);
      window.addEventListener('load', updateLoginLayout);

      // 图片预加载
      const eyeImg = new Image();
      eyeImg.src = "{{ eyeImagePath }}";
      const eyeCloseImg = new Image();
      eyeCloseImg.src = "{{ eyeCloseImagePath }}";

      document.querySelectorAll('.password-field').forEach(container => {
        const eyeElem = container.querySelector('.eye-toggle');
        const passwordInput = container.querySelector('input[type="password"]');
        eyeElem.style.webkitMaskImage = "url('" + eyeCloseImg.src + "')";
        eyeElem.style.maskImage = "url('" + eyeCloseImg.src + "')";

        eyeElem.addEventListener("click", function() {
          if (passwordInput.type === "password") {
            passwordInput.setAttribute("type", "text");
            eyeElem.style.webkitMaskImage = "url('" + eyeImg.src + "')";
            eyeElem.style.maskImage = "url('" + eyeImg.src + "')";
          } else {
            passwordInput.setAttribute("type", "password");
            eyeElem.style.webkitMaskImage = "url('" + eyeCloseImg.src + "')";
            eyeElem.style.maskImage = "url('" + eyeCloseImg.src + "')";
          }
        })
      })

      updateLoginLayout();

      function hideChangePasswordModal() {
        document.getElementById('change-password-modal').classList.add('hidden')
      }

      function updateBottomDisplay(message) {
        const bottomText = document.getElementById('modal-bottom-text');
        if (bottomText) {
          bottomText.textContent = message;
          bottomText.classList.remove('hidden');
        }
      }

      function handleChangePassword() {
        const newPassword = document.querySelector('input[name="newPassword"]').value.trim();
        const confirmPassword = document.querySelector('input[name="confirmPassword"]').value.trim();
        const passwordRegex = /^(?=.*\d)(?=.*[a-zA-Z])(?=.*[`~!@#\$%^&*()_+\-[\];',./{}|:"<>?]).{8,}$/

        if (!newPassword || !confirmPassword) {
          updateBottomDisplay("{{authTexts.changePassword.allFieldsAreMandatory}}");
          return;
        }

        if (newPassword !== confirmPassword) {
          updateBottomDisplay("{{authTexts.changePassword.passwordInconsistent}}");
          return;
        }

        if(!passwordRegex.test(newPassword)) {
          updateBottomDisplay("{{authTexts.changePassword.passwordRuleVerification}}");
          return;
        }

        const btn = document.getElementById("submit-btn");
        if (btn.disabled) return;
        btn.disabled = true;
        btn.innerHTML = "{{authTexts.changePassword.submitting}}";

        fetch("{{ changePasswordUserSelf }}", {
          method: "PATCH",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify({
            id: "{{changePasswordPamars.username}}",
            oldPassword: "{{changePasswordPamars.password}}",
            newPassword: newPassword
          }),}
          ).then((res) => {
            if(res?.status === 500){
              btn.innerHTML = "{{authTexts.changePassword.confirm}}";
              btn.disabled = false;
              updateBottomDisplay("{{authTexts.changePassword.invalidUserNamePassword}}");
            }else if(res?.status === 204){
              updateBottomDisplay("{{authTexts.changePassword.modificationSuccessed}}");

              const loginForm = document.getElementById("loginForm")
              loginForm.elements.username.value = "{{changePasswordPamars.username}}";
              loginForm.elements.password.value = newPassword;
              setTimeout(()=>{
                loginForm.submit();
              }, 1000)
            }else{
              btn.innerHTML = "{{authTexts.changePassword.confirm}}";
              btn.disabled = false;
              updateBottomDisplay("{{authTexts.changePassword.modificationFailed}}");
            }
          }).catch((e) => {
            btn.innerHTML = "{{authTexts.changePassword.confirm}}";
            btn.disabled = false;
            updateBottomDisplay("{{authTexts.changePassword.modificationFailed}}");
          }
        );
      }
    </script>
</body>
</html>
